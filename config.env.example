# OneBot HTTP API endpoint (e.g. go-cqhttp, Lagrange.OneBot)
ONEBOT_HTTP_URL=http://127.0.0.1:5700
ONEBOT_ACCESS_TOKEN=

# Comma-separated QQ group IDs to monitor
GROUP_IDS=123456789,987654321

# Polling interval in seconds
POLL_INTERVAL=60

# Max messages to fetch per poll
FETCH_LIMIT=50

# Sentiment score thresholds (0.0 ~ 1.0)
NEGATIVE_THRESHOLD=0.3
POSITIVE_THRESHOLD=0.7

# Alert when negative message ratio exceeds this value
ALERT_NEGATIVE_RATIO=0.4

# Output directory for reports
REPORT_DIR=reports

# Comma-separated keywords that trigger alerts
ALERT_KEYWORDS=退群,骂人,投诉,举报,垃圾

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
